# Base de données. En local, un simple fichier SQLite suffit.
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les sessions (mets une longue chaîne aléatoire en prod)
JWT_SECRET="change-moi-en-production"

# Clés VAPID pour les notifications push : générées avec `npm run generate:vapid`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Doit être publique côté client, donc préfixée par NEXT_PUBLIC_
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
