// Schéma de la base de données — ce projet est configuré pour PostgreSQL
// (Neon en production). Ne repasse jamais ce provider à "sqlite" dans les
// prochains zips : la vraie base du projet est du Postgres.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Statut du jour : "AVAILABLE" (chaud), "UNAVAILABLE" (pas aujourd'hui), ou null (rien dit).
  // drinkStatusDate sert à faire expirer automatiquement le statut le lendemain.
  drinkStatus     String?
  drinkStatusDate DateTime?

  // Abonnement aux notifications push (JSON stringifié : endpoint + clés)
  pushSubscription String?

  // Photo de profil : petite vignette carrée, stockée en data URL directement
  // (pas de service de stockage externe à configurer).
  avatarUrl String?

  // Défi temporaire WebAuthn (Face ID / biométrie), le temps d'une cérémonie
  // d'enregistrement ou de connexion. Effacé juste après usage.
  currentChallenge String?

  invitesSent     Invite[]          @relation("HostInvites")
  inviteReceipts  InviteRecipient[]

  friendshipsA Friendship[] @relation("UserA")
  friendshipsB Friendship[] @relation("UserB")

  statusLogs     StatusLog[]
  cursesReceived Curse[]     @relation("CursedUser")
  cursesGiven    Curse[]     @relation("CursedBy")
  credentials    Credential[]
  teams          Team[]
}

// Une Team = un sous-ensemble d'amis nommé, pour aller plus vite au moment
// d'inviter (ex: "Les copains", "Collègues"...). Propre à chaque utilisateur.
model Team {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  icon      String   @default("🍺")
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())

  owner   User         @relation(fields: [ownerId], references: [id])
  members TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String // l'ami membre de cette Team

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, userId])
}

// Une clé d'accès biométrique (Face ID, Touch ID, empreinte Android...)
// enregistrée sur un appareil pour se reconnecter sans mot de passe.
model Credential {
  id           String   @id // credential ID encodé en base64url, fourni par l'appareil
  userId       String
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceLabel  String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Historique quotidien du statut "chaud"/"pas chaud", utilisé pour calculer
// les classements (séries, nombre de refus...). gameDay = début de la
// "journée de jeu" (5h du matin) à laquelle ce statut se rapporte.
model StatusLog {
  id      String   @id @default(cuid())
  userId  String
  gameDay DateTime
  status  String // "AVAILABLE" | "UNAVAILABLE"

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, gameDay])
}

// Une malédiction posée par un hôte sur un invité qui ne s'est pas présenté.
// redeemed : passe à true quand la "tournée double" a été payée — la
// malédiction compte toujours au classement, mais la dette est soldée.
model Curse {
  id             String   @id @default(cuid())
  inviteId       String
  cursedUserId   String
  cursedByUserId String
  redeemed       Boolean  @default(false)
  createdAt      DateTime @default(now())

  invite   Invite @relation(fields: [inviteId], references: [id])
  cursedUser   User @relation("CursedUser", fields: [cursedUserId], references: [id])
  cursedBy     User @relation("CursedBy", fields: [cursedByUserId], references: [id])

  @@unique([inviteId, cursedUserId])
}

// Une amitié est stockée une seule fois entre deux utilisateurs.
// status : PENDING (demande envoyée par requestedBy), ACCEPTED
model Friendship {
  id          String   @id @default(cuid())
  userAId     String
  userBId     String
  status      String   @default("PENDING")
  requestedBy String
  createdAt   DateTime @default(now())

  userA User @relation("UserA", fields: [userAId], references: [id])
  userB User @relation("UserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Invite {
  id              String    @id @default(cuid())
  hostId          String
  message         String
  location        String
  showRecipients  Boolean   @default(true)
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?

  host       User              @relation("HostInvites", fields: [hostId], references: [id])
  recipients InviteRecipient[]
  curses     Curse[]
}

model InviteRecipient {
  id             String  @id @default(cuid())
  inviteId       String
  userId         String
  status         String  @default("SENT") // SENT, SEEN, JOINED, DECLINED, CANCELLED
  note           String?
  noteVisibility String? // "PUBLIC" | "HOST"

  invite Invite @relation(fields: [inviteId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([inviteId, userId])
}
